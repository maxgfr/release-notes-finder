    "@chakra-ui/react": "^2.4.1",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "chakra-ui-markdown-renderer": "^4.1.0",
    "framer-motion": "^7.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.6.0",
    "react-markdown": "^8.0.3",
    "rehype-raw": "^6.1.1",
    "rehype-sanitize": "^5.0.1",
    "remark-gfm": "^3.0.1",
    "semver": "^7.7.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^28.1.8",
    "@types/node": "^12.20.55",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.9",
    "@types/semver": "^7.7.0",
    "gh-pages": "^4.0.0",
    "prettier": "^3.8.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build -u \"github-actions-bot <support+actions@github.com>\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "react-scripts test --watchAll=false --runInBand",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.cjs",
    "validate": "yarn typecheck && yarn test:unit && yarn build && yarn check:bundle && yarn test:e2e"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
